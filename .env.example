# Admin Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
TOKEN_EXPIRE_SECONDS=86400

# Database
POSTGRES_USER=fft
POSTGRES_PASSWORD=fft_secret
POSTGRES_DB=fft_sitereport
DATABASE_URL=postgresql+asyncpg://fft:fft_secret@postgres:5432/fft_sitereport

# Groq - Voice to Text (Whisper)
GROQ_API_KEY=gsk_your_groq_api_key_here

# DeepSeek - Text Summarization
DEEPSEEK_API_KEY=sk-your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# NAS - Synology DSM FileStation API
# Docker: use host.docker.internal (requires extra_hosts in docker-compose.yml)
NAS_URL=http://host.docker.internal:5001
NAS_USERNAME=your_nas_username
NAS_PASSWORD=
NAS_SHARED_FOLDER=/shared-folder/subfolder
NAS_VERIFY_SSL=false
NAS_TIMEOUT=30
NAS_UPLOAD_TIMEOUT=120
